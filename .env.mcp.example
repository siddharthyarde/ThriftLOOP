# Claude Code reads these from your shell environment before you run `claude`.
# Do not put real secrets in .mcp.json.

# Token-backed MCP servers
GITHUB_TOKEN=
RENDER_API_KEY=
NETLIFY_PERSONAL_ACCESS_TOKEN=

# Razorpay expects base64("key_id:key_secret"), not the raw key secret.
RAZORPAY_MERCHANT_TOKEN=

# Shiprocket local MCP bridge. Use either a token or email/password.
SHIPROCKET_TOKEN=
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=

# Optional, only if you want higher Context7 limits and add the header later.
CONTEXT7_API_KEY=
